{
  "name": "dsh-token-plugin",
  "version": "2.1.0",
  "description": "DeepSeek Harness usage & cost tracker plugin: per-call token/cache-hit stats, peak/off-peak billing, CSV/JSON/PNG export with custom destination, and persistent local storage. Ships a host half plus a web client half in one npm package; installs into a DSH profile as a dsh.bundle from a local package or a published release.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "usage",
    "cost",
    "tokens",
    "cache"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realhenrylan/dsh-token-plugin.git"
  },
  "contributors": [
    {
      "name": "ayleen",
      "url": "https://github.com/ayleen"
    },
    {
      "name": "wuhuqif176",
      "url": "https://github.com/wuhuqif176"
    },
    {
      "name": "Martin-soaring-dev",
      "url": "https://github.com/Martin-soaring-dev"
    },
    {
      "name": "liu3734",
      "url": "https://github.com/liu3734"
    },
    {
      "name": "mumuer1024",
      "url": "https://github.com/mumuer1024"
    },
    {
      "name": "zhiqiangme",
      "url": "https://github.com/zhiqiangme"
    },
    {
      "name": "vb2250158",
      "url": "https://github.com/vb2250158"
    }
  ],
  "homepage": "https://github.com/realhenrylan/dsh-token-plugin#readme",
  "bugs": {
    "url": "https://github.com/realhenrylan/dsh-token-plugin/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync": "node sync-to-profile.mjs",
    "wire": "node scripts/wire.js",
    "check": "node scripts/check-package.js",
    "prepublishOnly": "node scripts/check-package.js",
    "pack": "npm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "undici": "^7.0.0"
  }
}
